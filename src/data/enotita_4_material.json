  "exercises": [
    {
      "id": "4.1",
      "title": "Συμπλήρωσε τα κενά με το Αόριστο Άρθρο και τις προθέσεις όπου χρειάζεται",
      "type": "worked_examples_only",
      "note_gr": "Στο παρόν διαθέσιμο αρχείο σώζονται οι λυμένες προτάσεις, όχι το ξεχωριστό φύλλο άσκησης με κενά.",
      "items": [
        {
          "number": 1,
          "solved_text": "Cathe dzuâ cumpâru nâshtĭ culurâchi ci nji arâsescu multu."
        },
        {
          "number": 2,
          "solved_text": "Face s’ mângu nâshtĭ? Hiu adjunâ!"
        },
        {
          "number": 3,
          "solved_text": "Featili tuti au noau stranji ma di unâ featâ stranjili suntu veclji."
        },
        {
          "number": 4,
          "solved_text": "Prinde s’dai cartea aestâ la unu omu ci s’cljeamâ Tea."
        },
        {
          "number": 5,
          "solved_text": "Cumu s’face si zburâshti cu unu omu ci nu cunoshti?"
        },
        {
          "number": 6,
          "solved_text": "Unâ soatsâ amea are unâ casâ ninga amarea."
        },
        {
          "number": 7,
          "solved_text": "A cui easte aestu câne ci alatrâ ashĭ? Easte di nâshĭtsĭ vicinji."
        },
        {
          "number": 8,
          "solved_text": "Ljau dulcenji di la nâshtĭ muljeri ci lucreadzâ aoa ma în ghiosu."
        },
        {
          "number": 9,
          "solved_text": "Avde aoace! Di nâshĭtsĭ/ nâshtĭ ahtâri oaminji si ti hârneshti!"
        },
        {
          "number": 10,
          "solved_text": "-Iu hi? – Hiu la nâshtĭ soatsĭ. Yinu ayonjia/ anghiu!"
        }
      ]
    },
