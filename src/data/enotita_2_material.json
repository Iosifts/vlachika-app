    "dialogues": [
      {
        "id": "2.1.a",
        "title": "Tachi & Maria",
        "lines": [
          {
            "speaker": "Tachi",
            "text": "Bunâ dzuâ!"
          },
          {
            "speaker": "Maria",
            "text": "Bunâ dzuâ! Cari hi tine?"
          },
          {
            "speaker": "Tachi",
            "text": "Io hiu Tachi. Cumu ti cljeamâ tine?"
          },
          {
            "speaker": "Maria",
            "text": "Mi cljeamâ Maria. D’iu hi Tachi?"
          },
          {
            "speaker": "Tachi",
            "text": "Io hiu di Arbinisii. Tine d’ iu hi?"
          },
          {
            "speaker": "Maria",
            "text": "Hiu Armânâ di Grecia. Hoara amea easte Perĭvolea."
          },
          {
            "speaker": "Tachi",
            "text": "Shĭ io Armânu hiu.. di Kortsha!"
          },
          {
            "speaker": "Lena",
            "text": "Bunâ searâ! Io hiu Lena."
          }
        ]
      },
      {
        "id": "2.1.b",
        "title": "Lena & Yachi",
        "lines": [
          {
            "speaker": "Lena",
            "text": "Bunâ searâ! Io hiu Lena."
          },
          {
            "speaker": "Yachi",
            "text": "Mi hârsescu multu Lena! Numa amea easte Yachi."
          },
          {
            "speaker": "Lena",
            "text": "Shĭ io mi hârsescu Yachi ci ti cunoscu. Hi Grecu?"
          },
          {
            "speaker": "Yachi",
            "text": "Nu hiu Grecu, hiu Arbinesu."
          },
          {
            "speaker": "Lena",
            "text": "Shĭ io Arbineasâ hiu ma bânedzu tu Grecia."
          },
          {
            "speaker": "Yachi",
            "text": "Si armâni ghine Lena!"
          },
          {
            "speaker": "Lena",
            "text": "Oarâ bunâ Yachi!"
          },
          {
            "speaker": "Flora",
            "text": "Bunâ searâ!"
          }
        ]
      },
      {
        "id": "2.1.c",
        "title": "Flora & Nia",
        "lines": [
          {
            "speaker": "Flora",
            "text": "Bunâ searâ!"
          },
          {
            "speaker": "Nia",
            "text": "Bunâ searâ! Ghine vinishĭ!"
          },
          {
            "speaker": "Flora",
            "text": "Ghine ti aflai!"
          },
          {
            "speaker": "Nia",
            "text": "Cari tsî i numa?"
          },
          {
            "speaker": "Flora",
            "text": "Hiu Flora. Tine, cumu ti grescu?"
          },
          {
            "speaker": "Nia",
            "text": "Mi grescu Nia."
          },
          {
            "speaker": "Flora",
            "text": "Nia...mŭshatâ numâ! Ma lipseashte si fugu tora."
          },
          {
            "speaker": "Nia",
            "text": "Noapte bunâ si ai Flora!"
          },
          {
            "speaker": "Flora",
            "text": "Noapte bunâ Nia!"
          }
        ]
      }
    ],
