        {
          "vlach": "Hiu nipŭtutâ / lângitâ",
          "greek": "είμαι άρρωστη."
        },
        {
          "vlach": "Hiu trâ moarte",
          "greek": "είμαι του θανατά."
        },
        {
          "vlach": "Nu mi ducu ghine",
          "greek": "δεν πάω καλά."
        }
      ],
