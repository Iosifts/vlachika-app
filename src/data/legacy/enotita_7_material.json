                  "έρχομαι": "yinu"
                },
                {
                  "δίνω": "dai",
                  "φέρνω": "aduci",
                  "έρχομαι": "yini"
                },
                {
                  "δίνω": "da",
                  "φέρνω": "aduce",
                  "έρχομαι": "yine"
                },
                {
                  "δίνω": "dâmu / dâdemu",
                  "φέρνω": "a(du)cemu",
                  "έρχομαι": "yinimu"
                },
                {
                  "δίνω": "dacĭ / dâdecĭ",
                  "φέρνω": "a(du)cecĭ",
                  "έρχομαι": "yinicĭ"
                },
                {
                  "δίνω": "da",
                  "φέρνω": "aducu",
                  "έρχομαι": "yinu"
                }
              ]
            },
            {
              "type": "bullet_list",
              "title": "Χρήσιμες εκφράσεις με dau / aducu / yinu",
              "items": [
                "dau di + ουσιαστικό = ακουμπάω, αγγίζω, συναντώ τυχαία",
                "dau si + ρήμα = προσπαθώ να",
                "dau stî = χτυπάω, δέρνω",
                "dau cale = διώχνω",
                "da chicuti / ploae / neau / cheamete = ψιχαλίζει / βρέχει / χιονίζει / γίνεται κατακλυσμός",
                "dau buyiau = βάφω",
                "dau zboru = υπόσχομαι, λογοδίνομαι",
                "da soarĭle = ανατέλλει ο ήλιος",
                "dau = βρωμάω",
                "dau = ανθίζω",
                "mi dau di (în) pade = χτυπιέμαι κάτω / επιμένω",
                "nji si da tu minte = μου έρχεται στη μνήμη",
                "aducu di a minte / tu minte = θυμάμαι",
                "yine aloatŭlu = φουσκώνει το προζύμι",
                "nji yine si + ρήμα = μου έρχεται να",
                "nji yine + somnu / foame / frigu / soare = μου έρχεται νύστα / πείνα / κρύο / ζέστη"
              ]
            }
          ]
        }
