      {
        "section_id": "6.3",
        "title": "Iu aljiurea avemu numiri?",
        "teaching_goal": "Χρήση αριθμών σε μήνες, έτη, ηλικία, τιμές και βάρος.",
        "content": {
          "question_patterns": [
            {
              "vlach": "Câtu are/ easte mesŭlu?",
              "greek": "πόσο έχει/ είναι ο μήνας?"
            },
            {
              "vlach": "Ci anu avemu?",
              "greek": "τι χρονιά έχουμε?"
            },
            {
              "vlach": "Cari anu?",
              "greek": "ποια χρονιά?"
            },
            {
              "vlach": "Câtu face?",
              "greek": "πόσο κάνει/κοστίζει"
            },
            {
              "vlach": "Di câtsĭ anji hi?",
              "greek": "πόσο χρονών είσαι?"
            },
            {
              "vlach": "Câtu dhixeashte?/ Câtu greu easte?",
              "greek": "πόσο ζυγίζει?"
            }
          ],
          "quantifier_notes": [
            {
              "vlach": "câtu – câtsĭ",
              "greek": "πόσος – πόσοι"
            },
            {
              "vlach": "câtâ – câti",
              "greek": "πόση - πόσες"
            },
            {
              "vlach": "Câtu mŭshatâ easte feata aceâ!",
              "greek": "παράδειγμα επιρρηματικής χρήσης"
            },
            {
              "vlach": "Câtu afischi suntu nâshti oaminji!",
              "greek": "παράδειγμα"
            }
          ]
        }
      },
